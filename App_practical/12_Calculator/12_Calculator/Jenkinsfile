pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello Jenkins'
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('App_practical/12_Calculator/12_Calculator') {
                    sh 'ls -l'
                    sh 'docker compose build'
                }
            }
        }
        stage('Start Docker Container') {
            steps {
                dir('App_practical/12_Calculator/12_Calculator') {
                    sh 'docker compose up -d'
                }
            }
        }
    }
}