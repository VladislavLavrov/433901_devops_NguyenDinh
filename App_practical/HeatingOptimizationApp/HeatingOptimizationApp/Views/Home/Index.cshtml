@model HeatingOptimizationApp.Models.HeatingViewModel
@{
    ViewData["Title"] = "Оптимизация обогрева";
}

<div class="container mt-4">
    <h2 class="text-center text-primary">Система расчета оптимального обогрева помещений</h2>

    
    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5>Ввод исходных данных</h5>
        </div>
        <div class="card-body">
            <form asp-action="Calculate" method="post">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Потребности агрегатов (B_i), т:</h6>
                        <div class="input-group mb-2">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="input-group-prepend"><span class="input-group-text">Агрегат @(i + 1)</span></div>
                                <input type="number" step="any" name="Demand[@i]" value="@Model.Demand[i]" class="form-control" required />
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6>Запасы топлива (R_j), т:</h6>
                        <div class="input-group mb-2">
                            @for (int j = 0; j < 3; j++)
                            {
                                <div class="input-group-prepend"><span class="input-group-text">Топливо @(j + 1)</span></div>
                                <input type="number" step="any" name="Reserves[@j]" value="@Model.Reserves[j]" class="form-control" required />
                            }
                        </div>
                    </div>
                </div>

                <h6 class="mt-3">Матрица теплотворной способности (Q_ij), МДж/т:</h6>
                <table class="table table-bordered text-center">
                    <thead>
                        <tr>
                            <th>Агрегат \ Топливо</th>
                            <th>Топливо 1</th>
                            <th>Топливо 2</th>
                            <th>Топливо 3</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 4; i++)
                        {
                            <tr>
                                <td><strong>Агрегат @(i + 1)</strong></td>
                                @for (int j = 0; j < 3; j++)
                                {
                                    <td>
                                        <input type="number" step="any" name="QMatrix[@i,@j]" value="@Model.QMatrix[i, j]" class="form-control text-center" required />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-primary btn-lg">🔄 Выполнить расчет</button>
                </div>
            </form>
        </div>
    </div>


    @if (Model.Result != null)
    {
        @if (Model.Result.Status == "ОПТИМАЛЬНО")
        {
            <div class="alert alert-success text-center mt-4">
                <h4>✅ Статус: НАЙДЕНО ОПТИМАЛЬНОЕ РЕШЕНИЕ</h4>
                <h3>Максимальное количество теплоты (Z_max) = <strong>@Model.Result.MaxHeat.ToString("F2")</strong> МДж</h3>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <h4>Матрица распределения топлива (X)</h4>
                    <table class="table table-bordered table-striped text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>Агрегат</th>
                                <th>Топливо 1</th>
                                <th>Топливо 2</th>
                                <th>Топливо 3</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 4; i++)
                            {
                                <tr>
                                    <td><strong>Агрегат @(i + 1)</strong></td>
                                    @for (int j = 0; j < 3; j++)
                                    {
                                        <td>@Model.Result.X?[i, j]</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="col-md-6">
                    <h4>Диаграмма распределения топлива</h4>
                    <canvas id="myChart"></canvas>
                </div>
            </div>

            <div class="text-center mt-4 mb-5">
                <form asp-action="ExportToExcel" method="post">
                 
                    @for (int i = 0; i < 4; i++)
                    {
                        <input type="hidden" name="Demand[@i]" value="@Model.Demand[i]" />
                    }
                    @for (int j = 0; j < 3; j++)
                    {
                        <input type="hidden" name="Reserves[@j]" value="@Model.Reserves[j]" />
                    }
                    @for (int i = 0; i < 4; i++)
                    {
                        for (int j = 0; j < 3; j++)
                        {
                            <input type="hidden" name="QMatrix[@i,@j]" value="@Model.QMatrix[i, j]" />
                        }
                    }

                    <button type="submit" class="btn btn-success btn-lg">📥 Экспорт отчета в Excel</button>
                </form>
            </div>

      
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                var xData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Result.X!));
                var labels = ['Агрегат 1', 'Агрегат 2', 'Агрегат 3', 'Агрегат 4'];
                var dataValues = [];

                if(xData) {
                    for(var i = 0; i < 4; i++) {
                        dataValues.push(xData[i][0] + xData[i][1] + xData[i][2]);
                    }
                }

                var ctx = document.getElementById('myChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Общий расход топлива (т)',
                            data: dataValues,
                            backgroundColor: ['rgba(255, 99, 132, 0.7)', 'rgba(54, 162, 235, 0.7)', 'rgba(255, 206, 86, 0.7)', 'rgba(75, 192, 192, 0.7)']
                        }]
                    },
                    options: { scales: { y: { beginAtZero: true } } }
                });
            </script>
        }
        else
        {
            <div class="alert alert-danger text-center mt-4">
                <h4>❌ Ошибка: @Model.Result.Status</h4>
            </div>
        }
    }
</div>